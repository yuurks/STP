# Discord Developer Portal -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=your-discord-bot-token

# Discord Developer Portal -> Your App -> General Information -> Application ID
DISCORD_CLIENT_ID=your-discord-application-client-id

# Free key at https://twelvedata.com/ (used for /scan market data)
TWELVE_DATA_API_KEY=your-twelve-data-api-key

# Optional -- overrides the default Discord invite used in /shorts captions and buttons.
# DISCORD_INVITE_URL=https://discord.gg/your-invite

# Required for /shorts to upload videos straight to YouTube instead of just handing you the file.
# Run `node scripts/youtube-authorize.js` for the one-time setup steps that produce all three of
# these -- there's no way to skip that step, Google requires the channel owner's explicit consent.
# Leave these unset and /shorts still works fine -- it just falls back to attaching the video file
# for you to upload by hand.
# YOUTUBE_CLIENT_ID=your-oauth-client-id
# YOUTUBE_CLIENT_SECRET=your-oauth-client-secret
# YOUTUBE_REFRESH_TOKEN=your-refresh-token

# Optional -- YouTube video category ID for uploads (default: 25, News & Politics).
# YOUTUBE_CATEGORY_ID=25

# Optional -- background music for the /shorts video. Drop a real, properly licensed audio file
# at assets/music/background.mp3 and it's picked up automatically (looped to fill the video,
# trimmed to match) -- no video is silent-by-mistake, but nothing plays until a real file exists
# there. Override the path instead of using the default location:
# SHORTS_MUSIC_PATH=assets/music/your-track.mp3
